# AeroFlow environment variables.
#
# Copy this file to `.env` and fill in real values to run dbt against Snowflake
# or Databricks:
#     cp .env.example .env
#
# The local DuckDB target needs NONE of these: it is the default and works out
# of the box. They are only read by the `snowflake` and `databricks` targets in
# transform/profiles.yml and by the matching raw loaders in ingestion/ (values
# below are placeholders, not real secrets).

# =========================== Snowflake (--target snowflake) ===========================

# Snowflake account identifier, e.g. ab12345.eu-west-1
SNOWFLAKE_ACCOUNT=your_account_identifier

# Login + password (or use key-pair auth and adapt profiles.yml and
# ingestion/load_snowflake.py)
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password

# Role / compute / storage. The database must already exist; the raw loader
# creates its RAW schema, LANDING stage and raw tables.
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=AEROFLOW
SNOWFLAKE_SCHEMA=MAIN

# ========================== Databricks (--target databricks) ==========================

# Workspace hostname WITHOUT https://, e.g. dbc-a1b2c3d4-e5f6.cloud.databricks.com
DATABRICKS_HOST=your_workspace_hostname

# SQL warehouse HTTP path (SQL Warehouses > your warehouse > Connection details)
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your_warehouse_id

# Personal access token (Settings > Developer > Access tokens)
DATABRICKS_TOKEN=your_personal_access_token

# Unity Catalog catalog (Free Edition ships one named "workspace") and the
# fallback schema. Models still land in the raw / staging / intermediate / marts
# schemas of that catalog.
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=aeroflow
