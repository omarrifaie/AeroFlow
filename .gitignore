# ---------------------------------------------------------------------------
# AeroFlow .gitignore
# Keep build artifacts, downloaded data, secrets and vendored deps out of git.
# ---------------------------------------------------------------------------

# Downloaded raw data + any built warehouse
data/
transform/aeroflow.duckdb
*.duckdb
*.duckdb.wal

# Secrets / local env
.env
.env.*
!.env.example

# dbt build artifacts (transform/package-lock.yml is tracked on purpose: it pins
# the exact dbt package versions that `dbt deps` installs)
transform/target/
transform/dbt_packages/
transform/logs/
transform/.user.yml

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/
build/
dist/

# Evidence / Node
node_modules/
dashboard/.evidence/
dashboard/build/
dashboard/.svelte-kit/

# OS / editor / tooling
.DS_Store
Thumbs.db
.idea/
.vscode/

